# =============================================================================
# .env.example — Universidad de San Luis · infraestructura (eventos y datos).  Author: @Raven
# Copiar a .env:   cp .env.example .env
# Solo credenciales de los CONTENEDORES. El código Python (dev) va aparte y se
# conecta a estos servicios por 127.0.0.7.
# =============================================================================

# ── MinIO (almacén de objetos S3 · payloads del claim-check) ──
MINIO_ROOT_USER=veritas_admin
MINIO_ROOT_PASSWORD=veritas_admin_tesis
MINIO_BUCKET=unsl-documentos

# ── Grafana (perfil obs). Consola: http://127.0.0.7:3000 (admin/…) ──
GRAFANA_ADMIN_PASSWORD=admin

# ── Graylog (gestión de logs). Consola: http://127.0.0.7:9900 ──
# Usuario: admin · contraseña = la que corresponda al SHA2 de abajo (default 'admin').
GRAYLOG_PASSWORD_SECRET=tesis_pepper_cambialo_16+
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918

# ── Endpoints que usará el desarrollo (host → 127.0.0.7) ──
# (referencia para configurar la app que corre por fuera)
MONGO_HOSTS=127.0.0.7:27017
REDIS_HOST=127.0.0.7
REDIS_PORT=6379
WEAVIATE_HOST=127.0.0.7
WEAVIATE_PORT=8087
WEAVIATE_SCHEME=http
KAFKA_BOOTSTRAP_SERVERS=127.0.0.7:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
MINIO_ENDPOINT=127.0.0.7:9000
MINIO_SECURE=false
