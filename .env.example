# =============================================================================
# Chatbot (gen-ai-backend) — entorno de DESARROLLO (corre FUERA de Docker).
# Copiar a .env y completar las claves. Se conecta a la infra dockerizada de la
# tesis en 127.0.0.7 (levantar antes: dockers/docker-platforms → docker compose up -d).
# =============================================================================

# ── Config saneada de la tesis (override del loader; NO toca el config del host) ──
CHATBOT_CONFIG_YML=/home/athenas/DESARROLLO/Agentica/config/config.yml

# ── Auth (JWT HS256): mismo secreto para /dev/token y para validar ──
JWT_SECRET=cambia-esto-por-un-secreto-largo-para-la-tesis
ENABLE_DEV_TOKEN=true

# ── OpenAI (requerido para respuestas reales). Se usan ambos nombres. ──
OPENAI_API_KEY=
OPENAI_APIKEY=

# ── Infra de la tesis (127.0.0.7) ──
MONGO_URI=mongodb://127.0.0.7:27017/
REDIS_HOST=127.0.0.7
REDIS_PORT=6379

# ── UI chainlit → backend ──
UNSL_API_BASE=http://127.0.0.1:8080
UNSL_EMPRESA=UNSL
UNSL_TOPICO=LEGAL
UNSL_USER=alumno@tesis.local

# ── Pegasus · navegación autónoma — integrado en la app única ──
AGENT_MODEL=gpt-4o-mini
SEARCH_MODEL=gpt-4o-mini
OPENAI_SEARCH_TOOL=web_search_preview
AGENT_RECURSION_LIMIT=25
